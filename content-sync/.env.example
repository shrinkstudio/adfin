# Luma calendar API key (Luma Plus, scoped to the Adfin calendar)
LUMA_API_KEY=

# Webflow site API token with CMS read/write (Site settings > Apps & integrations > API access)
WEBFLOW_API_TOKEN=

# Events collection on ss-adfin-staging (default baked into the script)
EVENTS_COLLECTION_ID=6a74ab1e0f9d8a5183a5f044

# Set to false once editors start renaming events in the CMS
NAME_FOLLOWS_LUMA=true
