---
export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Adfin · Events sync</title>
    <style is:global>
      :root {
        --green: #084235;
        --ink: #0e1b17;
        --paper: #fafaf7;
        --mint: #ddf3e7;
        --line: #e3e3dc;
        --amber: #f5e6c4;
        --red: #f3d9d4;
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font: 15px/1.5 -apple-system, "Helvetica Neue", Arial, sans-serif;
        padding: 48px 24px;
      }
      main { max-width: 880px; margin: 0 auto; }
      h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
        font-size: 34px;
        color: var(--green);
        margin-bottom: 4px;
      }
      .sub { color: #5a6963; margin-bottom: 32px; }
      button, input[type="password"] {
        font: inherit;
        border-radius: 0;
        border: 1px solid var(--green);
        padding: 10px 18px;
      }
      button {
        background: var(--green);
        color: #fff;
        cursor: pointer;
      }
      button:disabled { opacity: 0.5; cursor: wait; }
      button.ghost { background: transparent; color: var(--green); }
      table { width: 100%; border-collapse: collapse; margin-top: 24px; }
      th {
        text-align: left;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #5a6963;
        padding: 8px 12px;
        border-bottom: 1px solid var(--green);
      }
      td { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
      td.date { white-space: nowrap; color: #5a6963; }
      .chip {
        display: inline-block;
        font-size: 12px;
        padding: 2px 8px;
        background: var(--mint);
        color: var(--green);
        white-space: nowrap;
      }
      .chip.new { background: var(--amber); color: #6b5410; }
      .chip.warn { background: var(--red); color: #7a2e1d; }
      .bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background: #fff;
        border: 1px solid var(--line);
      }
      #result { margin-top: 16px; padding: 12px 16px; background: var(--mint); display: none; }
      #result.error { background: var(--red); }
      a { color: var(--green); }
      .muted { color: #8a968f; font-size: 13px; }
    </style>
  </head>
  <body>
    <main>
      <h1>Events sync</h1>
      <p class="sub">Luma calendar → website events</p>

          <div class="bar">
            <div>
              <strong id="summary">Loading events…</strong>
              <div class="muted">
                New events arrive as drafts. Set Event Type and Short Description in the
                Editor, then publish.
              </div>
            </div>
            <button id="sync" disabled>Sync now</button>
          </div>
          <div id="result"></div>
          <table hidden id="table">
            <thead>
              <tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th></tr>
            </thead>
            <tbody id="rows"></tbody>
          </table>
    </main>

    <script>
        const chips = {
          new: '<span class="chip new">Not on site yet</span>',
          draft: '<span class="chip new">Draft, needs curation</span>',
          staged: '<span class="chip">Ready, awaiting publish</span>',
          published: '<span class="chip">Live</span>',
        };
        const fmt = (iso) =>
          iso
            ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
            : '';

        const load = async () => {
          const res = await fetch('/sync/api/status');
          if (!res.ok) throw new Error((await res.json()).error ?? res.statusText);
          const data = await res.json();
          const pending =
            data.events.filter((e) => e.status === 'new').length +
            data.events.filter((e) => e.pendingUpdate).length;
          document.getElementById('summary').textContent =
            `${data.events.length} events on Luma · ` +
            (pending ? `${pending} change${pending === 1 ? '' : 's'} to sync` : 'everything in sync');
          document.getElementById('rows').innerHTML = data.events
            .map(
              (e) => `<tr>
                <td><a href="${e.lumaUrl}" target="_blank" rel="noreferrer">${e.name}</a></td>
                <td class="date">${fmt(e.startAt)}</td>
                <td>${e.location ?? ''}</td>
                <td>${chips[e.status] ?? e.status}${e.pendingUpdate ? ' <span class="chip new">Update waiting</span>' : ''}</td>
              </tr>`
            )
            .join('');
          document.getElementById('table').hidden = false;
          document.getElementById('sync').disabled = false;
        };

        const show = (text, isError) => {
          const el = document.getElementById('result');
          el.textContent = text;
          el.className = isError ? 'error' : '';
          el.style.display = 'block';
        };

        document.getElementById('sync').addEventListener('click', async (e) => {
          e.target.disabled = true;
          e.target.textContent = 'Syncing…';
          try {
            const res = await fetch('/sync/api/sync', { method: 'POST' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error ?? res.statusText);
            show(
              data.created.length || data.updated.length
                ? `Done. ${data.created.length} new draft${data.created.length === 1 ? '' : 's'}, ${data.updated.length} updated.`
                : 'Done. Everything was already in sync.'
            );
            await load();
          } catch (err) {
            show(`Sync failed: ${err.message}`, true);
          } finally {
            e.target.disabled = false;
            e.target.textContent = 'Sync now';
          }
        });

        load().catch((err) => show(`Could not load status: ${err.message}`, true));
    </script>
  </body>
</html>
