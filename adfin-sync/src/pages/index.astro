---
export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Adfin · Content sync</title>
    <style is:global>
      :root {
        --green: #084235;
        --ink: #0e1b17;
        --paper: #fafaf7;
        --mint: #ddf3e7;
        --line: #e3e3dc;
        --amber: #f5e6c4;
        --red: #f3d9d4;
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font: 15px/1.5 -apple-system, "Helvetica Neue", Arial, sans-serif;
        padding: 48px 24px;
      }
      main { max-width: 880px; margin: 0 auto; }
      h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
        font-size: 34px;
        color: var(--green);
        margin-bottom: 4px;
      }
      h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
        font-size: 24px;
        color: var(--green);
        margin: 48px 0 12px;
      }
      .sub { color: #5a6963; margin-bottom: 8px; }
      button {
        font: inherit;
        border-radius: 0;
        border: 1px solid var(--green);
        padding: 10px 18px;
        background: var(--green);
        color: #fff;
        cursor: pointer;
      }
      button:disabled { opacity: 0.5; cursor: wait; }
      table { width: 100%; border-collapse: collapse; margin-top: 16px; }
      th {
        text-align: left;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #5a6963;
        padding: 8px 12px;
        border-bottom: 1px solid var(--green);
      }
      td { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
      td img { display: block; width: 88px; aspect-ratio: 16/9; object-fit: cover; }
      .titlecell { display: flex; align-items: center; gap: 12px; }
      a.ghost {
        display: inline-block;
        border: 1px solid var(--green);
        color: var(--green);
        padding: 9px 18px;
        text-decoration: none;
        white-space: nowrap;
      }
      .actions { display: flex; gap: 8px; align-items: center; }
      td.date { white-space: nowrap; color: #5a6963; }
      .chip {
        display: inline-block;
        font-size: 12px;
        padding: 2px 8px;
        background: var(--mint);
        color: var(--green);
        white-space: nowrap;
      }
      .chip.new { background: var(--amber); color: #6b5410; }
      .bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background: #fff;
        border: 1px solid var(--line);
      }
      .result { margin-top: 12px; padding: 12px 16px; background: var(--mint); display: none; }
      .result.error { background: var(--red); }
      a { color: var(--green); }
      .muted { color: #8a968f; font-size: 13px; }
    </style>
  </head>
  <body>
    <main>
      <h1>Content sync</h1>
      <p class="sub">Everything arrives as a draft. Curate and publish in the Editor.</p>

      <section data-sync="events">
        <h2>Events</h2>
        <p class="sub">Luma calendar → website events. Set Event Type and Short Description on new drafts.</p>
        <div class="bar">
          <strong data-role="summary">Loading…</strong>
          <div class="actions">
            <a class="ghost" href="https://ss-adfin-staging.webflow.io/?edit" target="_blank" rel="noreferrer">Curate in Editor</a>
            <button data-role="button" disabled>Sync events</button>
          </div>
        </div>
        <div class="result" data-role="result"></div>
        <table hidden data-role="table">
          <thead><tr><th>Event</th><th>Date</th><th>Detail</th><th>Status</th></tr></thead>
          <tbody data-role="rows"></tbody>
        </table>
      </section>

      <section data-sync="videos">
        <h2>Videos</h2>
        <p class="sub">YouTube channel → website videos, with the YouTube thumbnails. Publish only the ones that belong on the site.</p>
        <div class="bar">
          <strong data-role="summary">Loading…</strong>
          <div class="actions">
            <a class="ghost" href="https://ss-adfin-staging.webflow.io/?edit" target="_blank" rel="noreferrer">Curate in Editor</a>
            <button data-role="button" disabled>Sync videos</button>
          </div>
        </div>
        <div class="result" data-role="result"></div>
        <table hidden data-role="table">
          <thead><tr><th>Video</th><th>Date</th><th>Detail</th><th>Status</th></tr></thead>
          <tbody data-role="rows"></tbody>
        </table>
      </section>
    </main>

    <script>
      const chips = {
        new: '<span class="chip new">Not on site yet</span>',
        draft: '<span class="chip new">Draft, needs curation</span>',
        staged: '<span class="chip">Ready, awaiting publish</span>',
        published: '<span class="chip">Live</span>',
      };
      const fmt = (iso) =>
        iso
          ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
          : '';
      const ago = (iso) => {
        if (!iso) return null;
        const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
        if (mins < 2) return 'just now';
        if (mins < 60) return `${mins} min ago`;
        if (mins < 48 * 60) return `${Math.round(mins / 60)}h ago`;
        return `${Math.round(mins / 1440)}d ago`;
      };

      const wire = (name, endpoints, mapRow, summarise) => {
        const root = document.querySelector(`[data-sync="${name}"]`);
        const el = (role) => root.querySelector(`[data-role="${role}"]`);

        const show = (text, isError) => {
          const box = el('result');
          box.textContent = text;
          box.className = isError ? 'result error' : 'result';
          box.style.display = 'block';
        };

        const load = async () => {
          const res = await fetch(endpoints.status);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? res.statusText);
          el('summary').textContent = summarise(data);
          el('rows').innerHTML = data[name]
            .map(
              (row) => `<tr>
                <td><div class="titlecell">${row.thumb ? `<img src="${row.thumb}" alt="" loading="lazy">` : ''}<a href="${row.url ?? row.lumaUrl}" target="_blank" rel="noreferrer">${mapRow.title(row)}</a></div></td>
                <td class="date">${fmt(mapRow.date(row))}</td>
                <td>${mapRow.detail(row) ?? ''}</td>
                <td>${chips[row.status] ?? row.status}${row.pendingUpdate ? ' <span class="chip new">Update waiting</span>' : ''}</td>
              </tr>`
            )
            .join('');
          el('table').hidden = false;
          el('button').disabled = false;
        };

        el('button').addEventListener('click', async (e) => {
          e.target.disabled = true;
          const label = e.target.textContent;
          e.target.textContent = 'Syncing…';
          try {
            let createdTotal = 0;
            let updatedTotal = 0;
            for (;;) {
              const res = await fetch(`${endpoints.sync}?limit=8`, { method: 'POST' });
              const data = await res.json();
              if (!res.ok) throw new Error(data.error ?? res.statusText);
              createdTotal += data.created.length;
              updatedTotal += data.updated.length;
              if (!data.remaining) break;
              e.target.textContent = `Syncing… ${data.remaining} left`;
            }
            show(
              createdTotal || updatedTotal
                ? `Done. ${createdTotal} new draft${createdTotal === 1 ? '' : 's'}, ${updatedTotal} updated.`
                : 'Done. Everything was already in sync.'
            );
            await load();
          } catch (err) {
            show(`Sync failed: ${err.message}`, true);
          } finally {
            e.target.disabled = false;
            e.target.textContent = label;
          }
        });

        load().catch((err) => show(`Could not load: ${err.message}`, true));
      };

      wire(
        'events',
        { status: '/sync/api/status', sync: '/sync/api/sync' },
        { title: (r) => r.name, date: (r) => r.startAt, detail: (r) => r.location },
        (d) => {
          const pending =
            d.events.filter((e) => e.status === 'new').length +
            d.events.filter((e) => e.pendingUpdate).length;
          const when = ago(d.lastActivity);
          return `${d.events.length} events on Luma · ${pending ? `${pending} change${pending === 1 ? '' : 's'} to sync` : 'in sync'}${when ? ` · updated ${when}` : ''}`;
        }
      );

      wire(
        'videos',
        { status: '/sync/api/videos-status', sync: '/sync/api/videos-sync' },
        { title: (r) => r.name, date: (r) => r.publishedAt, detail: () => '' },
        (d) => {
          const pending =
            d.videos.filter((v) => v.status === 'new').length +
            d.videos.filter((v) => v.pendingUpdate).length;
          const when = ago(d.lastActivity);
          return `${d.videos.length} videos on the channel · ${pending ? `${pending} change${pending === 1 ? '' : 's'} to sync` : 'in sync'}${when ? ` · updated ${when}` : ''}`;
        }
      );
    </script>
  </body>
</html>
